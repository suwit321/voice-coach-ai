# Voice Coach AI - Environment Variables
# Copy this file to .env and fill in your values

# App Settings
APP_NAME=Voice Coach AI
DEBUG=true

# Database
DATABASE_URL=sqlite:///./voice_coach.db

# File Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=100
MAX_DURATION_SEC=600

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# LLM Provider: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-openai-key-here

# STT Provider (Speech-to-Text)
STT_PROVIDER=openai
STT_API_KEY=sk-your-openai-key-here

# Audio Retention (hours, 0 = delete immediately after analysis)
AUDIO_RETENTION_HOURS=0
